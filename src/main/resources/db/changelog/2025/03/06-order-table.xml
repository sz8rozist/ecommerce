<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1743415854904-1" author="rozsaistvan">
        <createTable tableName="orders">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_orders"/>
            </column>
            <column name="order_date" type="DATETIME"/>
            <column name="order_address" type="VARCHAR(255)"/>
            <column name="status" type="VARCHAR(255)"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1743415854904-2" author="rozsaistvan">
        <createTable tableName="orders_item">
            <column name="cart_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="orders_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1743415854904-3" author="rozsaistvan">
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="orders" constraintName="FK_ORDERS_ON_USER"
                                 referencedColumnNames="id" referencedTableName="user"/>
    </changeSet>
    <changeSet id="1743415854904-4" author="rozsaistvan">
        <addForeignKeyConstraint baseColumnNames="cart_id" baseTableName="orders_item"
                                 constraintName="fk_ordite_on_cart" referencedColumnNames="id"
                                 referencedTableName="cart"/>
    </changeSet>
    <changeSet id="1743415854904-5" author="rozsaistvan">
        <addForeignKeyConstraint baseColumnNames="orders_id" baseTableName="orders_item"
                                 constraintName="fk_ordite_on_order" referencedColumnNames="id"
                                 referencedTableName="orders"/>
    </changeSet>

</databaseChangeLog>