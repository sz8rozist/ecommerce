<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1743415723404-1" author="rozsaistvan">
        <createTable tableName="product_image">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_productimage"/>
            </column>
            <column name="image_url" type="VARCHAR(255)"/>
            <column name="product_id" type="BIGINT"/>
        </createTable>
    </changeSet>
    <changeSet id="1743415723404-2" author="rozsaistvan">
        <addForeignKeyConstraint baseColumnNames="product_id" baseTableName="product_image"
                                 constraintName="FK_PRODUCTIMAGE_ON_PRODUCT" referencedColumnNames="id"
                                 referencedTableName="product"/>
    </changeSet>

</databaseChangeLog>