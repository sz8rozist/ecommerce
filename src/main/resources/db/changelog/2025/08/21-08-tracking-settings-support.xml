<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="2025-08-21-order-tracking-1" author="rozsaistvan">
        <addColumn tableName="orders">
            <column name="tracking_number" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="2025-08-21-store-settings-1" author="rozsaistvan">
        <createTable tableName="store_settings">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_store_settings"/>
            </column>
            <column name="store_name" type="VARCHAR(255)"/>
            <column name="contact_email" type="VARCHAR(255)"/>
            <column name="currency" type="VARCHAR(10)"/>
        </createTable>
    </changeSet>

    <changeSet id="2025-08-21-support-ticket-1" author="rozsaistvan">
        <createTable tableName="support_ticket">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_support_ticket"/>
            </column>
            <column name="subject" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="datetime">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2025-08-21-support-ticket-2" author="rozsaistvan">
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="support_ticket"
                                 constraintName="FK_SUPPORT_TICKET_ON_USER" referencedColumnNames="id"
                                 referencedTableName="user"/>
    </changeSet>

    <changeSet id="2025-08-21-support-message-1" author="rozsaistvan">
        <createTable tableName="support_message">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_support_message"/>
            </column>
            <column name="ticket_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="sender_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="message" type="VARCHAR(2000)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="datetime">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2025-08-21-support-message-2" author="rozsaistvan">
        <addForeignKeyConstraint baseColumnNames="ticket_id" baseTableName="support_message"
                                 constraintName="FK_SUPPORT_MESSAGE_ON_TICKET" referencedColumnNames="id"
                                 referencedTableName="support_ticket"/>
    </changeSet>

    <changeSet id="2025-08-21-support-message-3" author="rozsaistvan">
        <addForeignKeyConstraint baseColumnNames="sender_id" baseTableName="support_message"
                                 constraintName="FK_SUPPORT_MESSAGE_ON_SENDER" referencedColumnNames="id"
                                 referencedTableName="user"/>
    </changeSet>

</databaseChangeLog>
