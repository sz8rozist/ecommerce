<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="2025-08-21-cart-1" author="rozsaistvan">
        <addColumn tableName="cart">
            <column name="user_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet id="2025-08-21-cart-2" author="rozsaistvan">
        <sql>DELETE FROM cart WHERE id NOT IN (SELECT carts_id FROM user_carts)</sql>
    </changeSet>

    <changeSet id="2025-08-21-cart-3" author="rozsaistvan">
        <sql>UPDATE cart c JOIN user_carts uc ON uc.carts_id = c.id SET c.user_id = uc.user_id</sql>
    </changeSet>

    <changeSet id="2025-08-21-cart-4" author="rozsaistvan">
        <addNotNullConstraint tableName="cart" columnName="user_id" columnDataType="BIGINT"/>
    </changeSet>

    <changeSet id="2025-08-21-cart-5" author="rozsaistvan">
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="cart" constraintName="FK_CART_ON_USER"
                                 referencedColumnNames="id" referencedTableName="user"/>
    </changeSet>

    <changeSet id="2025-08-21-cart-6" author="rozsaistvan">
        <dropTable tableName="user_carts"/>
    </changeSet>

    <changeSet id="2025-08-21-orders-1" author="rozsaistvan">
        <addColumn tableName="orders">
            <column name="shipping_method_id" type="BIGINT"/>
            <column name="payment_method_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet id="2025-08-21-orders-2" author="rozsaistvan">
        <addForeignKeyConstraint baseColumnNames="shipping_method_id" baseTableName="orders"
                                 constraintName="FK_ORDERS_ON_SHIPPING_METHOD" referencedColumnNames="id"
                                 referencedTableName="shipping_method"/>
    </changeSet>

    <changeSet id="2025-08-21-orders-3" author="rozsaistvan">
        <addForeignKeyConstraint baseColumnNames="payment_method_id" baseTableName="orders"
                                 constraintName="FK_ORDERS_ON_PAYMENT_METHOD" referencedColumnNames="id"
                                 referencedTableName="payment_method"/>
    </changeSet>

</databaseChangeLog>
