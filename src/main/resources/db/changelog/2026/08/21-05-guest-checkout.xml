<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="2026-08-21-guest-checkout-1" author="rozsaistvan">
        <dropNotNullConstraint tableName="orders" columnName="user_id" columnDataType="BIGINT"/>
    </changeSet>

    <changeSet id="2026-08-21-guest-checkout-2" author="rozsaistvan">
        <addColumn tableName="orders">
            <column name="guest_name" type="VARCHAR(255)"/>
            <column name="guest_email" type="VARCHAR(255)"/>
            <column name="guest_phone" type="VARCHAR(50)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
